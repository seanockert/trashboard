{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "trashboard",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": true,
	// seanockert.com must be a zone on this account.
	"routes": [
		{ "pattern": "trashboard.seanockert.com", "custom_domain": true }
	],
	"assets": {
		"directory": "./public"
	},
	"observability": {
		"enabled": true
	},
	// 19:00 UTC = 05:00 Brisbane.
	"triggers": {
		"crons": [
			"0 19 * * *"
		]
	},
	"ai": {
		"binding": "AI"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "trashboard",
			"database_id": "1e80d24a-e2ce-4f9a-b7af-d0b31aad10c0",
			"migrations_dir": "migrations"
		}
	],
	// Per IP. Counted per Cloudflare location, so approximate.
	"ratelimits": [
		{
			"name": "LOGIN_LIMIT",
			"namespace_id": "1001",
			"simple": {
				"limit": 5,
				"period": 60
			}
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "INGEST_QUEUE",
				"queue": "trashboard-ingest"
			},
			{
				"binding": "ITEM_QUEUE",
				"queue": "trashboard-items"
			}
		],
		"consumers": [
			// Free plan: 10 ms CPU, 50 subrequests per invocation.
			{
				"queue": "trashboard-ingest",
				"max_batch_size": 1,
				"max_retries": 3
			},
			// Concurrency 2 keeps detail fetches polite.
			{
				"queue": "trashboard-items",
				"max_batch_size": 1,
				"max_retries": 3,
				"max_concurrency": 2
			}
		]
	}
}